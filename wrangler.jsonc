{
  // Used by `wrangler` when NO --config is given (e.g. the Cloudflare Git integration for Worker "eurekacore").
  // The name is intentionally unchanged. Script, assets and API routing MUST mirror wrangler.toml, which is
  // authoritative; tests/wrangler-config.test.mjs fails if they drift. Routes/custom domain live only in wrangler.toml.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eurekacore",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
