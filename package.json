{
  "name": "eurekacore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:routing": "node --test tests/routing.test.mjs",
    "test:unit": "tsc --noEmit && node --test $(ls tests/*.test.mjs | grep -v routing.test.mjs)",
    "test:live": "node --test tests/live/*.live.test.mjs",
    "test": "rm -rf dist && vite build && npm run test:routing && npm run test:unit",
    "verify": "npm test && npm run deploy:check",
    "save": "node scripts/save-work.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "deploy:check": "wrangler deploy --dry-run --config wrangler.toml --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy --config wrangler.toml"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.99.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "ethers": "^6.17.0",
    "framer-motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "engines": {
    "node": "22.x"
  }
}
