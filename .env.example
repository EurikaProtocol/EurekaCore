NODE_VERSION=22
VITE_WALLETCONNECT_PROJECT_ID=
VITE_TINAN_TOKEN_ADDRESS=
VITE_TINAN_TOKEN_CHAIN_ID=
# Use only a public-safe RPC endpoint. VITE_ values are bundled into the browser app.
VITE_RPC_URL=
VITE_EXPLORER_URL=
VITE_SOLANA_NETWORK=
VITE_SOLANA_RPC_URL=
VITE_TINANAI_SOLANA_MINT=
VITE_PUMPFUN_TOKEN_URL=
VITE_TINANAI_METADATA_URI=

# TINAN AI currently uses deterministic local demo analysis; no provider API key is used.

# EurekaCore Phase 2 Worker API - NAMES ONLY. Set these as Cloudflare Worker secrets/vars, never in this file or the frontend.
# ACCESS_TEAM_DOMAIN=            (<team>.cloudflareaccess.com)
# ACCESS_AUD=                    (Cloudflare Access application audience tag)
# EUREKA_VIEWERS=  EUREKA_OPERATORS=  EUREKA_APPROVERS=   (comma-separated emails)
# GITHUB_TOKEN=  GITHUB_ALLOWED_REPOS=                    (owner/repo, comma-separated)
# SANDBOX_URL=  SANDBOX_TOKEN=                            (isolated runner, scripts/sandbox-service.mjs)
# TINANAI_BASE_URL=  TINANAI_USERNAME=  TINANAI_PASSWORD=
# D1 binding name: DB
